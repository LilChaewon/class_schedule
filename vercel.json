{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh ./vercel-build.sh",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
